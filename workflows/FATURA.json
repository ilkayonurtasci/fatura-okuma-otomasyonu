    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// AI Agent çıktısı 'output' içinde de gelebilir, doğrudan ana seviyede de gelebilir\nlet rawData = input.output || input;\n\n// Eğer AI Agent veriyi string/metin olarak döndürdüyse JSON'a çevirelim\nif (typeof rawData === 'string') {\n  try {\n    const cleanJson = rawData.replace(/```json/g, '').replace(/```/g, '').trim();\n    rawData = JSON.parse(cleanJson);\n  } catch (e) {\n    rawData = {};\n  }\n}\n\n// Güvenli veri çekme yardımcı fonksiyonu\nconst getVal = (key, fallback) => {\n  if (rawData[key] !== undefined && rawData[key] !== null && rawData[key] !== \"\") {\n    return rawData[key];\n  }\n  return fallback;\n};\n\n// Google Sheets sütun başlıklarınızla BİREBİR eşleşen çıktı\nreturn [{\n  json: {\n    satici_adi: getVal('satici_adi', 'Bulunamadı'),\n    vergi_no: getVal('vergi_no', 'Bulunamadı'),\n    fatura_no: getVal('fatura_no', 'Bulunamadı'),\n    tarih: getVal('tarih', 'Bulunamadı'),\n    urun_adi: getVal('urun_adi', getVal('urunler', 'Bulunamadı')),\n    fiyat: Number(getVal('fiyat', getVal('genel_toplam', 0))),\n    ara_toplam: Number(getVal('ara_toplam', 0)),\n    kdv: Number(getVal('kdv', 0)),\n    genel_toplam: Number(getVal('genel_toplam', 0)),\n    odeme_yontemi: getVal('odeme_yontemi', 'Belirtilmedi'),\n    kategori: getVal('kategori', 'Genel'),\n    son_iade_tarihi: getVal('son_iade_tarihi', 'Takip Edilemiyor'),\n    iade_durumu: getVal('iade_durumu', 'Aktif')\n  }\n}];"
      },
